{
  "$schema": "https://raw.githubusercontent.com/nicegoodthings/tauri-v2/main/tooling/config-schema/schema.json",
  "identifier": "default",
  "description": "默认权限",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-execute",
    "shell:allow-open",
    "notification:default",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "process:allow-exit",
    "process:allow-restart"
  ]
}
